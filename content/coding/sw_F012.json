  "solver_source": "from fractions import Fraction\ndef solve(params):\n    capacity = int(params[\"capacity\"])\n    weights = tuple(params[\"weights\"])\n    values = tuple(params[\"values\"])\n    n = len(weights)\n    dp = [0]*(capacity+1)\n    for i in range(n):\n        w = int(weights[i])\n        v = int(values[i])\n        for c in range(capacity, w-1, -1):\n            nv = dp[c-w] + v\n            if nv > dp[c]:\n                dp[c] = nv\n    ans = dp[capacity]\n    return {\"answer\": ans, \"steps\": {\"optimal_total_value\": ans}}",
