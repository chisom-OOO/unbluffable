  "solver_source": "def solve(params):\n    from fractions import Fraction\n    events = params[\"events\"]\n    book = {}\n    live_opposite_liquidity = 0\n    requested_market_qty = 0\n    filled_qty = 0\n    for ev in events:\n        kind = ev[\"kind\"]\n        if kind == \"add\":\n            book[ev[\"id\"]] = {\"side\": ev[\"side\"], \"qty\": int(ev[\"qty\"]), \"price\": ev[\"price\"]}\n        elif kind == \"cancel\":\n            cid = ev[\"id\"]\n            if cid in book:\n                del book[cid]\n        elif kind == \"market\":\n            m_side = ev[\"side\"]\n            m_qty = int(ev[\"qty\"])\n            requested_market_qty = m_qty\n            opp = \"sell\" if m_side == \"buy\" else \"buy\"\n            live_opposite_liquidity = sum(o[\"qty\"] for o in book.values() if o[\"side\"] == opp)\n            # market fills limited to live opposite liquidity, no partial beyond\n            filled_qty = m_qty if m_qty < live_opposite_liquidity else live_opposite_liquidity\n            # consume liquidity (not needed further but for correctness)\n            # we can simulate fill by reducing opposite orders\n            remaining = filled_qty\n            for oid in list(book.keys()):\n                if remaining <= 0:\n                    break\n                if book[oid][\"side\"] == opp:\n                    take = min(book[oid][\"qty\"], remaining)\n                    book[oid][\"qty\"] -= take\n                    remaining -= take\n                    if book[oid][\"qty\"] == 0:\n                        del book[oid]\n    answer = filled_qty\n    steps = {\"live_opposite_liquidity\": live_opposite_liquidity, \"requested_market_qty\": requested_market_qty, \"filled_qty\": filled_qty}\n    return {\"answer\": answer, \"steps\": steps}\n",
