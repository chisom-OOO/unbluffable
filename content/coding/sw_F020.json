  "solver_source": "def solve(params):\n    from fractions import Fraction\n    count = params['count']\n    values = params['values']\n    sorted_desc = sorted(values, reverse=True)\n    top_k = sorted_desc[:count]\n    total = sum(top_k)\n    kth_largest = sorted_desc[count-1] if count <= len(sorted_desc) else Fraction(0,1)\n    # ensure exact int/Fraction types\n    if isinstance(total, int):\n        ans = total\n    else:\n        ans = Fraction(total)\n    if isinstance(kth_largest, int):\n        kth = kth_largest\n    else:\n        kth = Fraction(kth_largest)\n    return {\"answer\": ans, \"steps\": {\"sum_of_top_k\": ans, \"kth_largest_value\": kth}}",
