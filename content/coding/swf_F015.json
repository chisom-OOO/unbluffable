  "solver_source": "from fractions import Fraction\ndef solve(params):\n    target = params[\"target\"]\n    values = params[\"values\"]\n    vals = tuple(values)\n    n = len(vals)\n    lo = 0\n    hi = n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if vals[mid] <= target:\n            lo = mid + 1\n        else:\n            hi = mid\n    if lo >= n:\n        ans = -1\n        idx = -1\n        qual = -1\n    else:\n        ans = vals[lo]\n        idx = lo\n        qual = vals[lo]\n    if isinstance(ans, str):\n        a = Fraction(ans)\n        if a.denominator == 1:\n            a = int(a)\n    else:\n        a = ans\n    return {\"answer\": a, \"steps\": {\"zero_based_index\": idx, \"qualifying_value\": qual}}",
