  "solver_source": "def solve(params):\n    from fractions import Fraction\n    events = params[\"events\"]\n    live = {}\n    for e in events:\n        kind = e[\"kind\"]\n        oid = e[\"id\"]\n        if kind == \"add\":\n            live[oid] = {\"price\": e[\"price\"], \"side\": e[\"side\"]}\n        elif kind == \"cancel\":\n            if oid in live:\n                del live[oid]\n        elif kind == \"modify\":\n            if oid in live:\n                if \"price\" in e:\n                    live[oid][\"price\"] = e[\"price\"]\n                if \"side\" in e:\n                    live[oid][\"side\"] = e[\"side\"]\n    bids = [v[\"price\"] for v in live.values() if v[\"side\"] == \"buy\"]\n    asks = [v[\"price\"] for v in live.values() if v[\"side\"] == \"sell\"]\n    best_bid = max(bids) if bids else None\n    best_ask = min(asks) if asks else None\n    answer = [best_bid, best_ask]\n    steps = {\"best_bid\": best_bid, \"best_ask\": best_ask}\n    return {\"answer\": answer, \"steps\": steps}\n",
