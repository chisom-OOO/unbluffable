  "solver_source": "def solve(params):\n    from fractions import Fraction\n    counts = params['counts']\n    cooldown = params['cooldown']\n    # ensure int handling (params may contain Fractions as strings but cooldown/counts are ints)\n    n = int(cooldown)\n    cnts = [int(c) for c in counts]\n    total_jobs = sum(cnts)\n    max_count = max(cnts)\n    num_max = sum(1 for c in cnts if c == max_count)\n    required_by_busiest = (max_count - 1) * (n + 1) + num_max\n    ans = total_jobs if total_jobs > required_by_busiest else required_by_busiest\n    return {\"answer\": ans, \"steps\": {\"total_jobs\": total_jobs, \"required_by_busiest\": required_by_busiest}}",
