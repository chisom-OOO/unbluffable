  "solver_source": "def solve(params):\n    vals = params[\"values\"]\n    n = len(vals)\n    # maximum product of non-empty contiguous subarray - track both max and min ending here\n    cur_max = vals[0]\n    cur_min = vals[0]\n    best = vals[0]\n    for i in range(1, n):\n        v = vals[i]\n        candidates = (v, cur_max * v, cur_min * v)\n        new_max = candidates[0]\n        for c in candidates[1:]:\n            if c > new_max:\n                new_max = c\n        new_min = candidates[0]\n        for c in candidates[1:]:\n            if c < new_min:\n                new_min = c\n        cur_max = new_max\n        cur_min = new_min\n        if cur_max > best:\n            best = cur_max\n    return {\"answer\": best, \"steps\": {\"maximum_consecutive_product\": best}}",
