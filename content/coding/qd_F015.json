  "solver_source": "def solve(params):\n    from math import comb\n    from fractions import Fraction\n    r=params['red']\n    b=params['black']\n    k=params['draws']\n    N=r+b\n    total=comb(N,k) if 0<=k<=N else 0\n    fav=comb(r,k) if 0<=k<=r else 0\n    ans=Fraction(fav, total) if total!=0 else Fraction(0,1)\n    return {\"answer\": ans, \"steps\": {\"total_unordered_hands\": total, \"favorable_red_hands\": fav}}\n",
