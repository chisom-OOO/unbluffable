  "solver_source": "def solve(params):\n    from fractions import Fraction\n    n=params[\"sides\"]\n    t=params[\"threshold\"]\n    total=n*n\n    fav=0\n    for s in range(t, 2*n+1):\n        if s < 2:\n            continue\n        if s <= n+1:\n            c=s-1\n        else:\n            c=2*n+1-s\n        if c>0:\n            fav+=c\n    # clamp threshold edge cases\n    if t <= 2:\n        fav=total\n    elif t > 2*n:\n        fav=0\n    ans=Fraction(fav, total) if total!=0 else Fraction(0,1)\n    return {\"answer\": ans, \"steps\": {\"total_ordered_outcomes\": Fraction(total,1), \"favorable_ordered_outcomes\": Fraction(fav,1)}}\n",
