  "solver_source": "def solve(params):\n    from fractions import Fraction\n    values = params['values']\n    n = len(values)\n    if n == 0:\n        return {'answer': 0, 'steps': {'total_trapped_water': 0, 'maximum_water_depth': 0}}\n    left_max = []\n    cur = values[0]\n    for i in range(n):\n        if values[i] > cur:\n            cur = values[i]\n        left_max.append(cur)\n    right_max = [0]*n\n    cur = values[-1]\n    for i in range(n-1, -1, -1):\n        if values[i] > cur:\n            cur = values[i]\n        right_max[i] = cur\n    total = 0\n    max_depth = 0\n    for i in range(n):\n        level = left_max[i] if left_max[i] < right_max[i] else right_max[i]\n        d = level - values[i]\n        if d < 0:\n            d = 0\n        total += d\n        if d > max_depth:\n            max_depth = d\n    return {'answer': int(total), 'steps': {'total_trapped_water': int(total), 'maximum_water_depth': int(max_depth)}}\n",
