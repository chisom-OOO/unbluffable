  "solver_source": "def solve(params):\n    from fractions import Fraction\n    import itertools\n    values = tuple(params['values'])\n    count = int(params['count'])\n    target = params['target']\n    n = len(values)\n    valid_combos = []\n    for idxs in itertools.combinations(range(n), count):\n        s = sum(values[i] for i in idxs)\n        if s == target:\n            combo = tuple(sorted(values[i] for i in idxs))\n            valid_combos.append(combo)\n    if valid_combos:\n        valid_combos.sort()\n        best = list(valid_combos[0])\n        best_exists = 1\n    else:\n        best = []\n        best_exists = 0\n    steps = {\n        \"valid_combination_count\": Fraction(len(valid_combos), 1),\n        \"best_solution_exists\": Fraction(best_exists, 1)\n    }\n    return {\"answer\": best, \"steps\": steps}\n",
