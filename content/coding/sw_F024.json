  "solver_source": "from fractions import Fraction\ndef solve(params):\n    vals=params[\"values\"]\n    n=len(vals)\n    total_subarrays=n*(n+1)//2\n    total=0\n    weighted=0\n    for i,v in enumerate(vals):\n        cnt=(i+1)*(n-i)\n        c=v*cnt\n        total+=c\n        weighted+=v*cnt  # same as total, kept for step clarity\n    # weighted sum is total; total_subarrays is intermediate\n    return {\"answer\": total, \"steps\": {\"total_number_of_slices\": Fraction(total_subarrays,1), \"total_weighted_sum\": Fraction(total,1)}}\n",
