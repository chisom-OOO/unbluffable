  "solver_source": "from fractions import Fraction\nimport math\ndef solve(params):\n    flips=int(params['flips'])\n    at_least=int(params['at_least'])\n    p=Fraction(params['head_probability'])\n    q=Fraction(1,1)-p\n    # tail probability single\n    prob_tail_single=q\n    # exact DP accumulate distribution\n    dp=[Fraction(0) for _ in range(flips+1)]\n    dp[0]=Fraction(1,1)\n    for _ in range(flips):\n        ndp=[Fraction(0) for _ in range(flips+1)]\n        for k in range(flips+1):\n            if dp[k]==0:\n                continue\n            ndp[k]+=dp[k]*q\n            if k+1 <= flips:\n                ndp[k+1]+=dp[k]*p\n        dp=ndp\n    total=Fraction(0)\n    for k in range(at_least, flips+1):\n        total+=dp[k]\n    return {\"answer\": total, \"steps\": {\"prob_tail_single\": prob_tail_single, \"prob_at_least_threshold\": total}}\n",
