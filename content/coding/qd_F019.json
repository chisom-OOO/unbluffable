  "solver_source": "def solve(params):\n    from fractions import Fraction\n    events = params['events']\n    queries = params['queries']\n    add_time = {}\n    cancel_time = {}\n    for e in events:\n        kind = e['kind']\n        oid = e['id']\n        t = e['time']\n        if kind == 'add':\n            if oid not in add_time:\n                add_time[oid] = t\n            else:\n                if t < add_time[oid]:\n                    add_time[oid] = t\n        elif kind == 'cancel':\n            if oid not in cancel_time:\n                cancel_time[oid] = t\n            else:\n                if t < cancel_time[oid]:\n                    cancel_time[oid] = t\n    ans = []\n    for q in queries:\n        cnt = 0\n        for oid, at in add_time.items():\n            if at <= q:\n                ct = cancel_time.get(oid, None)\n                if ct is None or ct > q:\n                    cnt += 1\n        ans.append(cnt)\n    num_events = len(events)\n    num_queries = len(queries)\n    total_alive_at_last_query = ans[-1] if ans else 0\n    return {\"answer\": ans, \"steps\": {\"num_events\": num_events, \"num_queries\": num_queries, \"total_alive_at_last_query\": total_alive_at_last_query}}\n",
