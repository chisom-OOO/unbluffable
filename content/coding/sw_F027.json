  "solver_source": "def solve(params):\n    from fractions import Fraction\n    words = params['words']\n    prefixes = set()\n    for w in words:\n        for k in range(1, len(w)+1):\n            prefixes.add(w[:k])\n    distinct = len(prefixes)\n    root = 1\n    answer = root + distinct\n    steps = {\n        \"distinct_nonempty_prefix_count\": distinct,\n        \"root_node_count\": root\n    }\n    return {\"answer\": answer, \"steps\": steps}\n",
