  "solver_source": "def solve(params):\n    from fractions import Fraction\n    limit = params[\"limit\"]\n    n = limit + 1\n    total = 0\n    k = 0\n    while (1 << k) <= limit:\n        cycle = 1 << (k + 1)\n        half = 1 << k\n        full = n // cycle\n        rem = n % cycle\n        extra = rem - half\n        if extra < 0:\n            extra = 0\n        cnt = full * half + extra\n        total += cnt\n        k += 1\n    highest_bit = k - 1 if k > 0 else 0\n    steps = {\"inclusive_count\": Fraction(n), \"highest_bit_index\": Fraction(highest_bit), \"total_one_bits\": Fraction(total)}\n    return {\"answer\": Fraction(total), \"steps\": steps}",
