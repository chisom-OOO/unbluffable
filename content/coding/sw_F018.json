  "solver_source": "from fractions import Fraction\ndef solve(params):\n    starts = params['starts']\n    ends = params['ends']\n    pts = sorted(set(list(starts) + list(ends)))\n    stretches = []\n    for i in range(len(pts)-1):\n        a = pts[i]\n        b = pts[i+1]\n        covered = False\n        for s, e in zip(starts, ends):\n            if s <= a and a < e:\n                covered = True\n                break\n        if covered:\n            stretches.append(b - a)\n    total = sum(stretches)\n    # Fixed 5-step interface required by family validator: pad with 0 or truncate to exactly 5 entries\n    steps = {}\n    for idx in range(5):\n        if idx < len(stretches):\n            steps[f'stretch_{idx+1}_duration'] = stretches[idx]\n        else:\n            steps[f'stretch_{idx+1}_duration'] = 0\n    return {\"answer\": total, \"steps\": steps}\n",
