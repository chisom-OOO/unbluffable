  "solver_source": "def solve(params):\n    from fractions import Fraction\n    values = params[\"values\"]\n    n = len(values)\n    # largest rectangle in histogram via monotonic stack\n    # compute for each bar the widest span where it is minimum\n    best_area = 0\n    best_height = None\n    best_width = None\n    # stack holds indices with increasing heights\n    stack = []\n    # iterate with sentinel 0 height at end to flush\n    for i in range(n+1):\n        cur_h = values[i] if i < n else 0\n        while stack and cur_h < values[stack[-1]]:\n            h = values[stack.pop()]\n            left = stack[-1] if stack else -1\n            width = i - left - 1\n            area = h * width\n            if area > best_area:\n                best_area = area\n                best_height = h\n                best_width = width\n        stack.append(i)\n    return {\"answer\": int(best_area), \"steps\": {\"best_rectangle_height\": int(best_height), \"best_rectangle_width\": int(best_width), \"best_rectangle_area\": int(best_area)}}\n",
