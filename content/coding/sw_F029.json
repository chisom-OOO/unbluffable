  "solver_source": "from fractions import Fraction\ndef solve(params):\n    values=tuple(params[\"values\"])\n    n=len(values)\n    prefix=[0]*(n+1)\n    for i,v in enumerate(values):\n        prefix[i+1]=prefix[i]+v\n    def seg_sum(i,j):\n        return prefix[j+1]-prefix[i]\n    dp=[[0]*n for _ in range(n)]\n    for length in range(2, n+1):\n        for i in range(n-length+1):\n            j=i+length-1\n            best=None\n            s=seg_sum(i,j)\n            for k in range(i, j):\n                c=dp[i][k]+dp[k+1][j]+s\n                if best is None or c<best:\n                    best=c\n            dp[i][j]=best\n    answer=dp[0][n-1] if n>1 else 0\n    steps={}\n    if n>1:\n        total=seg_sum(0,n-1)\n        for k in range(n-1):\n            cand=dp[0][k]+dp[k+1][n-1]+total\n            name=f\"final_split_after_position_{k+1}_total_cost\"\n            steps[name]=cand\n    return {\"answer\": answer, \"steps\": steps}\n",
