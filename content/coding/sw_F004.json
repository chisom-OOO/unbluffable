  "solver_source": "def solve(params):\n    from fractions import Fraction\n    vals=tuple(params['values'])\n    n=len(vals)\n    max_ending=vals[0]\n    max_sofar=vals[0]\n    for x in vals[1:]:\n        if max_ending + x > x:\n            max_ending = max_ending + x\n        else:\n            max_ending = x\n        if max_ending > max_sofar:\n            max_sofar = max_ending\n    max_linear = max_sofar\n    min_ending=vals[0]\n    min_sofar=vals[0]\n    for x in vals[1:]:\n        if min_ending + x < x:\n            min_ending = min_ending + x\n        else:\n            min_ending = x\n        if min_ending < min_sofar:\n            min_sofar = min_ending\n    total=sum(vals)\n    if n==1:\n        circular_via_complement = vals[0]\n    else:\n        if min_sofar == total:\n            circular_via_complement = max_linear\n        else:\n            circular_via_complement = total - min_sofar\n    ans = max_linear if max_linear > circular_via_complement else circular_via_complement\n    steps={'max_non_circular_subarray_sum': max_linear, 'max_circular_via_complement': circular_via_complement}\n    return {'answer': ans, 'steps': steps}\n",
