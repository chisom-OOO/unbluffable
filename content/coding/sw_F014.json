      "source": "def solve(params):\n    coins = params['coins']\n    target = params['target']\n    n = len(coins)\n    count = 0\n    stack = [(0, tuple(range(n)))]\n    while stack:\n        cur_sum, remaining = stack.pop()\n        if cur_sum == target:\n            count += 1\n            continue\n        if cur_sum > target:\n            continue\n        for k in range(len(remaining)):\n            idx = remaining[k]\n            new_sum = cur_sum + coins[idx]\n            if new_sum <= target:\n                new_remaining = remaining[:k] + remaining[k+1:]\n                stack.append((new_sum, new_remaining))\n            else:\n                if cur_sum + coins[idx] > target:\n                    continue\n    return count\n"
    }
