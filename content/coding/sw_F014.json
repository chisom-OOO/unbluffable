  "solver_source": "def solve(params):\n    coins = params['coins']\n    target = params['target']\n    dp = [0] * (target + 1)\n    dp[0] = 1\n    for i in range(1, target + 1):\n        s = 0\n        for c in coins:\n            if c <= i:\n                s += dp[i - c]\n        dp[i] = s\n    ans = dp[target]\n    return {\"answer\": ans, \"steps\": {\"ordered_sequences_count\": ans}}\n",
