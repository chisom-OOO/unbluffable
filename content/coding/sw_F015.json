  "solver_source": "def solve(params):\n    from fractions import Fraction\n    n = int(params[\"steps\"])\n    blocked = set(int(x) for x in params[\"blocked\"])\n    dp = {0: 1}\n    for i in range(1, n+1):\n        if i in blocked:\n            dp[i] = 0\n        else:\n            dp[i] = dp.get(i-1, 0) + dp.get(i-2, 0)\n    ans = dp[n]\n    penultimate = dp.get(n-1, 0) if n >= 1 else 0\n    antepenultimate = dp.get(n-2, 0) if n >= 2 else 0\n    return {\"answer\": ans, \"steps\": {\"routes_to_penultimate_step\": penultimate, \"routes_to_antepenultimate_step\": antepenultimate}}\n",
