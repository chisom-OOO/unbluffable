  "solver_source": "def solve(params):\n    from fractions import Fraction\n    a=params[\"faces_a\"]\n    b=params[\"faces_b\"]\n    n=a if a<=b else b\n    m=b if a<=b else a\n    exp_small_die_tail_contribution=Fraction(a,1)-Fraction((a-1)*a*(2*a-1), 6*a*b) if False else None\n    # general tail sums using min/max formula: E[max]=(m+1)/2 + (n*n-1)/(6*m)\n    tail_sum_small_range=Fraction(n,1)-Fraction((n-1)*n*(2*n-1), 6*n*m)\n    tail_sum_large_range=Fraction(m-n,1)-Fraction((m-1)*m//2 - (n-1)*n//2, m) if m!=n else Fraction(0,1)\n    expected_larger_roll=Fraction(m+1,2)+Fraction(n*n-1, 6*m)\n    return {\"answer\": expected_larger_roll, \"steps\": {\"tail_sum_small_range\": tail_sum_small_range, \"tail_sum_large_range\": tail_sum_large_range, \"expected_larger_roll\": expected_larger_roll}}\n",
