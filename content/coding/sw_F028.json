  "solver_source": "from fractions import Fraction\ndef solve(params):\n    vals = list(params['values'])\n    n = len(vals)\n    a = (1,) + tuple(vals) + (1,)\n    m = n+2\n    dp = [[0]*m for _ in range(m)]\n    for length in range(2, m):\n        for l in range(m-length):\n            r = l+length\n            best = 0\n            for k in range(l+1, r):\n                cur = dp[l][k] + dp[k][r] + a[l]*a[k]*a[r]\n                if cur > best:\n                    best = cur\n            dp[l][r] = best\n    ans = dp[0][m-1]\n    return {\"answer\": int(ans), \"steps\": {\"max_total_score\": int(ans)}}\n",
