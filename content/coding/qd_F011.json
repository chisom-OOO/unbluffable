  "solver_source": "def solve(params):\n    from fractions import Fraction\n    prices=tuple(params['prices'])\n    n=len(prices)\n    best_num=0\n    best_den=1\n    best_peak=prices[0]\n    best_trough=prices[0]\n    best_peak_idx=0\n    best_trough_idx=0\n    if n>0:\n        max_peak=prices[0]\n        max_peak_idx=0\n        for j in range(1,n):\n            pj=prices[j]\n            # drawdown from max_peak to j\n            if max_peak>pj:\n                num=max_peak-pj\n                den=max_peak\n                # compare num/den vs best_num/best_den\n                if num*best_den > best_num*den:\n                    best_num=num\n                    best_den=den\n                    best_peak=max_peak\n                    best_trough=pj\n                    best_peak_idx=max_peak_idx\n                    best_trough_idx=j\n            if pj>max_peak:\n                max_peak=pj\n                max_peak_idx=j\n    if best_num==0:\n        # no positive drawdown, define trough=peak for zero loss case (first price)\n        best_peak=prices[0] if n>0 else 0\n        best_trough=best_peak\n        best_num=0\n        best_den=best_peak if best_peak!=0 else 1\n        ans=Fraction(0,1)\n        loss=0\n    else:\n        ans=Fraction(best_num, best_den)\n        loss=best_peak-best_trough\n    return {\"answer\": ans, \"steps\": {\"peak_price\": best_peak, \"trough_price\": best_trough, \"price_loss\": loss, \"max_drawdown_fraction\": ans}}",
