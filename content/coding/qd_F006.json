  "solver_source": "def solve(params):\n    from fractions import Fraction\n    fills = params['fills']\n    total_cost = Fraction(0)\n    total_shares = 0\n    average_cost_before_sale = None\n    for f in fills:\n        price = Fraction(f['price'])\n        qty = int(f['qty'])\n        side = f['side']\n        if side == 'buy':\n            total_cost += price * qty\n            total_shares += qty\n        elif side == 'sell':\n            if average_cost_before_sale is None and total_shares != 0:\n                average_cost_before_sale = total_cost / total_shares\n            avg = total_cost / total_shares if total_shares != 0 else Fraction(0)\n            total_cost -= avg * qty\n            total_shares -= qty\n    if average_cost_before_sale is None:\n        average_cost_before_sale = total_cost / total_shares if total_shares !=0 else Fraction(0)\n    answer = total_cost / total_shares if total_shares != 0 else Fraction(0)\n    return {\"answer\": answer, \"steps\": {\"average_cost_before_sale\": average_cost_before_sale, \"total_shares_final\": Fraction(total_shares), \"total_cost_final\": total_cost}}\n",
