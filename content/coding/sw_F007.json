  "solver_source": "from fractions import Fraction\nimport math\ndef solve(params):\n    slots=params[\"slots\"]\n    values=params[\"values\"]\n    total_size=sum(values)\n    # naive average rate without per-file rounding: ceil(total/slots)\n    average_rate_lower_bound=(total_size + slots - 1)//slots\n    # binary search minimal k with sum ceil(v/k) <= slots\n    lo=1\n    hi=max(values)\n    # hi is always feasible if len(values) <= slots else may need larger, but sum ceil(v/max)=len <= slots assumed; extend if needed\n    while sum((v + hi -1)//hi for v in values) > slots:\n        hi*=2\n    while lo < hi:\n        mid=(lo+hi)//2\n        needed=sum((v + mid -1)//mid for v in values)\n        if needed <= slots:\n            hi=mid\n        else:\n            lo=mid+1\n    answer=lo\n    steps={\"total_size\": total_size, \"average_rate_lower_bound\": average_rate_lower_bound}\n    return {\"answer\": answer, \"steps\": steps}\n",
