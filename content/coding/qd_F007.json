  "solver_source": "def solve(params):\n    from fractions import Fraction\n    opening = params[\"opening\"]\n    fills = params[\"fills\"]\n    # total bought and total sold\n    total_bought = 0\n    total_sold = 0\n    for f in fills:\n        qty = f[\"qty\"]\n        side = f[\"side\"]\n        if side == \"buy\":\n            total_bought += qty\n        elif side == \"sell\":\n            total_sold += qty\n    final_position = opening + total_bought - total_sold\n    return {\"answer\": final_position, \"steps\": {\"total_bought_shares\": total_bought, \"total_sold_shares\": total_sold}}",
