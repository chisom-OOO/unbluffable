  "solver_source": "def solve(params):\n    from fractions import Fraction\n    events=tuple(params[\"events\"])\n    asks=[]\n    best_price_before=None\n    best_qty_before=None\n    market_qty=None\n    for e in events:\n        e=dict(e)\n        if e.get(\"kind\")==\"add\" and e.get(\"side\")==\"sell\":\n            asks.append([e[\"price\"], e[\"qty\"], e.get(\"id\")])\n        elif e.get(\"kind\")==\"market\" and e.get(\"side\")==\"buy\":\n            market_qty=e[\"qty\"]\n            if asks:\n                asks_sorted=sorted(asks, key=lambda x: x[0])\n                best_price_before=asks_sorted[0][0]\n                best_qty_before=asks_sorted[0][1]\n            qty_to_fill=market_qty\n            asks_sorted=sorted(asks, key=lambda x: x[0])\n            for lvl in asks_sorted:\n                if qty_to_fill<=0:\n                    break\n                take=min(lvl[1], qty_to_fill)\n                lvl[1]-=take\n                qty_to_fill-=take\n            asks=[lvl for lvl in asks_sorted if lvl[1]>0]\n    if not asks:\n        answer=[None, 0]\n        remaining_best_price=None\n        remaining_best_qty=0\n    else:\n        asks_sorted=sorted(asks, key=lambda x: x[0])\n        remaining_best_price=asks_sorted[0][0]\n        remaining_best_qty=asks_sorted[0][1]\n        answer=[remaining_best_price, remaining_best_qty]\n    steps={\"best_ask_price_before_market\": best_price_before if best_price_before is not None else 0, \"best_ask_qty_before_market\": best_qty_before if best_qty_before is not None else 0, \"market_buy_qty\": market_qty if market_qty is not None else 0, \"remaining_best_ask_price\": remaining_best_price if remaining_best_price is not None else 0, \"remaining_best_ask_qty\": remaining_best_qty}\n    return {\"answer\": answer, \"steps\": steps}\n",
