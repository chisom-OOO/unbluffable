  "solver_source": "def solve(params):\n    from fractions import Fraction\n    values = params[\"values\"]\n    k = params[\"length\"]\n    n = len(values)\n    # compute all window sums of exactly k consecutive entries\n    window_sums = []\n    cur = sum(values[0:k])\n    window_sums.append(cur)\n    for i in range(1, n - k + 1):\n        cur = cur - values[i-1] + values[i+k-1]\n        window_sums.append(cur)\n    answer = max(window_sums)\n    # steps: provide intermediate values for verification\n    # Use int/Fraction exact values\n    steps = {\n        \"number_of_windows\": n - k + 1,\n        \"maximum_window_sum\": answer,\n        \"first_window_sum\": window_sums[0]\n    }\n    return {\"answer\": answer, \"steps\": steps}",
