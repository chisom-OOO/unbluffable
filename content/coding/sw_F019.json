  "solver_source": "def solve(params):\n    from fractions import Fraction\n    starts=params['starts']\n    ends=params['ends']\n    n=len(starts)\n    pts=set()\n    for s,e in zip(starts, ends):\n        pts.add(Fraction(s))\n        pts.add(Fraction(e))\n    pts=sorted(pts)\n    total=Fraction(0)\n    for i in range(len(pts)-1):\n        a=pts[i]\n        b=pts[i+1]\n        if b<=a:\n            continue\n        mid=(a+b)/2\n        cnt=0\n        for s,e in zip(starts, ends):\n            s=Fraction(s)\n            e=Fraction(e)\n            if s <= mid < e:\n                cnt+=1\n        if cnt>=2:\n            total+=(b-a)\n    ans=int(total) if total.denominator==1 else total\n    # steps must be exact Fraction/int on same scale\n    return {\"answer\": ans, \"steps\": {\"duration_covered_at_least_two\": ans}}\n",
