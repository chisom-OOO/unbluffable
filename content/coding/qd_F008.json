  "solver_source": "from fractions import Fraction\ndef solve(params):\n    fee_cents=params['fee_cents']\n    fills=params['fills']\n    mark=params['mark']\n    total_buy_cost=Fraction(0)\n    total_sell_proceeds=Fraction(0)\n    total_buy_qty=0\n    total_sell_qty=0\n    fees=Fraction(0)\n    for f in fills:\n        price=Fraction(f['price'])\n        qty=Fraction(f['qty'])\n        fees+= qty * Fraction(fee_cents, 100)\n        if f['side']=='buy':\n            total_buy_cost+= price*qty\n            total_buy_qty+= qty\n        else:\n            total_sell_proceeds+= price*qty\n            total_sell_qty+= qty\n    remaining = total_buy_qty - total_sell_qty\n    mark_p=Fraction(mark)\n    # For steps: compute realized and unrealized using average cost / FIFO invariant via total method\n    # realized = sell proceeds - cost basis of sold shares (average cost)\n    # To get general realized/unrealized split that sums to cash flow + mark, use average cost\n    if total_buy_qty != 0:\n        avg_cost = total_buy_cost / total_buy_qty\n    else:\n        avg_cost = Fraction(0)\n    sold_qty = min(total_buy_qty, total_sell_qty)\n    # If short sales possible, handle symmetrically: realized still proceeds - cost, but cost for shorts is sale price? Simpler: use cash flow definition for steps\n    # Use cash-flow decomposition: realized = proceeds from closed qty - cost of closed qty\n    # closed qty = min(buy,sell)\n    # unrealized = remaining * (mark - avg_cost) if long remaining else remaining*...\n    # For pure long case this matches examples. For generalization ensure sum = proceeds - cost + remaining*mark\n    if total_buy_qty >= total_sell_qty:\n        realized = total_sell_proceeds - sold_qty * avg_cost\n        unrealized = remaining * (mark_p - avg_cost)\n    else:\n        # net short: avg sell price\n        avg_sell = total_sell_proceeds / total_sell_qty if total_sell_qty!=0 else Fraction(0)\n        realized = sold_qty * avg_sell - sold_qty * (total_buy_cost / sold_qty if sold_qty!=0 else Fraction(0)) if sold_qty!=0 else Fraction(0)\n        # Simpler fallback: realized as above still works if we define realized = sold_qty*(avg_sell - avg_cost)\n        if total_sell_qty !=0:\n            avg_sell = total_sell_proceeds/total_sell_qty\n            realized = sold_qty * (avg_sell - avg_cost) if sold_qty!=0 else Fraction(0)\n        else:\n            realized=Fraction(0)\n        unrealized = remaining * (mark_p - avg_sell) if total_sell_qty!=0 else remaining*mark_p\n        # Ensure total consistency: total = total_sell_proceeds - total_buy_cost + remaining*mark_p\n        # Adjust unrealized to satisfy\n        total_no_fee = total_sell_proceeds - total_buy_cost + remaining*mark_p\n        unrealized = total_no_fee - realized\n    total_no_fee = total_sell_proceeds - total_buy_cost + remaining*mark_p\n    answer = total_no_fee - fees\n    return {\"answer\": answer, \"steps\": {\"realized_profit_dollars\": realized, \"unrealized_profit_dollars\": unrealized, \"total_fees_dollars\": fees}}\n",
