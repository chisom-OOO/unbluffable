  "solver_source": "def solve(params):\n    from fractions import Fraction\n    values = params[\"values\"]\n    n = len(values)\n    seen = {}\n    left = 0\n    cur_sum = 0\n    best = None\n    # for steps we keep best as answer; also track number of distinct windows considered if needed\n    for right in range(n):\n        v = values[right]\n        # if duplicate inside window, shrink until duplicate removed\n        while v in seen and seen[v] >= left:\n            # move left past previous occurrence\n            prev_idx = seen[v]\n            # subtract values[left:prev_idx+1]\n            for k in range(left, prev_idx+1):\n                cur_sum -= values[k]\n            left = prev_idx + 1\n            break\n            # note: with general duplicates loop handles multiple; but for this family single duplicate suffices, still we handle via while\n        # Actually need iterative shrink for multiple duplicates: use while loop with left pointer and dict check\n        # Re-implement correctly with while v in window\n        # To keep simple, use set window check via loop above; ensure correctness for any input\n        # cur_sum currently without v, now add v\n        cur_sum += v\n        seen[v] = right\n        # However above shrink for single duplicate is incomplete if window contained duplicate not of v; but invariant ensures window was distinct before, so only v can duplicate\n        if best is None or cur_sum > best:\n            best = cur_sum\n    # best is int for these params\n    answer = best\n    steps = {\"max_distinct_window_sum\": answer}\n    return {\"answer\": answer, \"steps\": steps}\n",
