  "solver_source": "def solve(params):\n    from itertools import combinations\n    values=tuple(params['values'])\n    limit=params['limit']\n    n=len(values)\n    steps={}\n    total=0\n    for k in range(n+1):\n        cnt=0\n        if k==0:\n            cnt=1 if 0 <= limit else 0\n        else:\n            for combo in combinations(range(n), k):\n                s=sum(values[i] for i in combo)\n                if s <= limit:\n                    cnt+=1\n        steps[f'valid_count_size_{k}']=cnt\n        total+=cnt\n    return {'answer': total, 'steps': steps}",
