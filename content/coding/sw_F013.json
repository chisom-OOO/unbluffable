  "solver_source": "def solve(params):\n    from fractions import Fraction\n    coins = params[\"coins\"]\n    target = params[\"target\"]\n    # coins is tuple/list, target is int\n    n = len(coins)\n    # dp for unordered combinations: outer loop over coins\n    dp = [0] * (target + 1)\n    dp[0] = 1\n    for c in coins:\n        ci = int(c)\n        for amt in range(ci, target+1):\n            dp[amt] += dp[amt-ci]\n    ans = dp[target]\n    steps = {\n        \"ways_to_make_zero\": dp[0] if False else 1,\n        \"total_unordered_combinations\": ans\n    }\n    # Keep steps values as int/Fraction exact\n    # ways_to_make_zero is always 1 (base case)\n    steps[\"ways_to_make_zero\"] = 1\n    return {\"answer\": ans, \"steps\": steps}",
