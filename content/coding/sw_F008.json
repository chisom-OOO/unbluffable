  "solver_source": "from fractions import Fraction\ndef solve(params):\n    values=tuple(params[\"values\"])\n    k=int(params[\"groups\"])\n    n=len(values)\n    total=sum(values)\n    def feasible(C):\n        groups_needed=1\n        cur=0\n        for v in values:\n            if v>C:\n                return False\n            if cur+v<=C:\n                cur+=v\n            else:\n                groups_needed+=1\n                cur=v\n                if groups_needed>k:\n                    return False\n        return groups_needed<=k\n    lo=max(values)\n    hi=total\n    while lo<hi:\n        mid=(lo+hi)//2\n        if feasible(mid):\n            hi=mid\n        else:\n            lo=mid+1\n    answer=lo\n    lower_bound=max(max(values), (total + k - 1)//k)\n    return {\"answer\": answer, \"steps\": {\"total_workload\": total, \"lower_bound\": lower_bound, \"minimal_largest_group_total\": answer}}",
