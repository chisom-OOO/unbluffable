  "solver_source": "def solve(params):\n    values = params['values']\n    n = len(values)\n    total = values[0]\n    max_ending = values[0]\n    max_so_far = values[0]\n    min_ending = values[0]\n    min_so_far = values[0]\n    for x in values[1:]:\n        total += x\n        max_ending = x if max_ending + x < x else max_ending + x\n        if max_ending > max_so_far:\n            max_so_far = max_ending\n        min_ending = x if min_ending + x > x else min_ending + x\n        if min_ending < min_so_far:\n            min_so_far = min_ending\n    if max_so_far < 0:\n        return max_so_far\n    wrap = total - min_so_far\n    return wrap if wrap > max_so_far else max_so_far",
  "brute_force_source": "def solve(params):\n    values = params['values']\n    n = len(values)\n    best = values[0]\n    for start in range(n):\n        s = 0\n        for length in range(1, n+1):\n            s += values[(start + length - 1) % n]\n            if s > best:\n                best = s\n    return best",
