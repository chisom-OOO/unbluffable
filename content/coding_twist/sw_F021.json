  "solver_source": "def solve(params):\n    values = params[\"values\"]\n    # linear basis over GF(2) for max xor, works for Python ints (non-negative typical)\n    # use 64 bits to cover constraints\n    MAXB = 61\n    basis = [0] * (MAXB + 1)\n    for v in values:\n        x = v\n        for b in range(MAXB, -1, -1):\n            if (x >> b) & 1 == 0:\n                continue\n            if basis[b] == 0:\n                basis[b] = x\n                break\n            x ^= basis[b]\n    ans = 0\n    for b in range(MAXB, -1, -1):\n        if (ans ^ basis[b]) > ans:\n            ans ^= basis[b]\n    return ans\n",
  "brute_force_source": "def solve(params):\n    values = params[\"values\"]\n    n = len(values)\n    best = 0\n    # enumerate all non-empty subsets\n    for mask in range(1, 1 << n):\n        cur = 0\n        for i in range(n):\n            if (mask >> i) & 1:\n                cur ^= values[i]\n        if cur > best:\n            best = cur\n    # also allow empty xor 0 if it is larger (handles all negative case)\n    return best\n",
