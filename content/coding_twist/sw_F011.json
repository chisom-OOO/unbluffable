  "solver_source": "def solve(params):\n    vals = list(params['values'])\n    n = len(vals)\n    if n <= 1:\n        return 0\n    # duplicate for circular intervals\n    m = 2 * n\n    ext = vals + vals\n    prefix = [0]*(m+1)\n    for i, v in enumerate(ext):\n        prefix[i+1] = prefix[i] + v\n    def seg_sum(i, j):\n        return prefix[j+1] - prefix[i]\n    # dp[i][j] for 0<=i<=j<m\n    dp = [[0]*m for _ in range(m)]\n    for length in range(2, n+1):\n        for i in range(m - length + 1):\n            j = i + length - 1\n            if j - i + 1 > n:\n                continue\n            s = seg_sum(i, j)\n            best = None\n            for k in range(i, j):\n                c = dp[i][k] + dp[k+1][j] + s\n                if best is None or c < best:\n                    best = c\n            dp[i][j] = best\n    ans = None\n    for i in range(n):\n        j = i + n - 1\n        c = dp[i][j]\n        if ans is None or c < ans:\n            ans = c\n    return int(ans)",
  "brute_force_source": "def solve(params):\n    vals = tuple(params['values'])\n    n = len(vals)\n    if n <= 1:\n        return 0\n    memo = {}\n    def dfs(state):\n        if state in memo:\n            return memo[state]\n        m = len(state)\n        if m == 1:\n            memo[state] = 0\n            return 0\n        best = None\n        for i in range(m):\n            j = (i+1) % m\n            a = state[i]\n            b = state[j]\n            c = a + b\n            if j > i:\n                nxt = tuple(list(state[:i]) + [c] + list(state[j+1:]))\n            else:\n                # wrap pair: j==0 and i==m-1\n                nxt = tuple([c] + list(state[1:i]))\n            cost = c + dfs(nxt)\n            if best is None or cost < best:\n                best = cost\n        memo[state] = best\n        return best\n    return int(dfs(vals))",
