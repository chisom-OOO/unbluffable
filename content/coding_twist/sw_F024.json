  "solver_source": "def solve(params):\n    values=params[\"values\"]\n    n=len(values)\n    pref=0\n    sum_pref=0\n    sum_pref_sq=0\n    total=0\n    # pref[0]=0 is the initial l=0 value\n    # sum_pref and sum_pref_sq initially contain pref[0]\n    sum_pref=0\n    sum_pref_sq=0\n    r_count=1  # number of l values seen so far (pref0)\n    for v in values:\n        pref+=v\n        # contributions of all l < r where r is current prefix index\n        total+= r_count*pref*pref + sum_pref_sq - 2*pref*sum_pref\n        # add current pref to the pool for next r\n        sum_pref+=pref\n        sum_pref_sq+=pref*pref\n        r_count+=1\n    return total",
