  "solver_source": "def solve(params):\n    capacity = int(params['capacity'])\n    weights = list(params['weights'])\n    values = list(params['values'])\n    n = len(weights)\n    NEG = -10**18\n    dp_val = [NEG] * (capacity + 1)\n    dp_cnt = [0] * (capacity + 1)\n    dp_val[0] = 0\n    dp_cnt[0] = 1\n    for idx in range(n):\n        w = int(weights[idx])\n        v = int(values[idx])\n        for c in range(capacity, -1, -1):\n            if c >= w and dp_val[c - w] != NEG:\n                cand = dp_val[c - w] + v\n                if cand > dp_val[c]:\n                    dp_val[c] = cand\n                    dp_cnt[c] = dp_cnt[c - w]\n                elif cand == dp_val[c]:\n                    dp_cnt[c] += dp_cnt[c - w]\n    best = max(dp_val)\n    total = 0\n    for c in range(capacity + 1):\n        if dp_val[c] == best:\n            total += dp_cnt[c]\n    return int(total)",
  "brute_force_source": "def solve(params):\n    capacity = int(params['capacity'])\n    weights = list(params['weights'])\n    values = list(params['values'])\n    n = len(weights)\n    best = -1\n    count = 0\n    for mask in range(1 << n):\n        w = 0\n        v = 0\n        for i in range(n):\n            if mask >> i & 1:\n                w += int(weights[i])\n                v += int(values[i])\n        if w <= capacity:\n            if v > best:\n                best = v\n                count = 1\n            elif v == best:\n                count += 1\n    return int(count)",
