  "solver_source": "def solve(params):\n    count = params['count']\n    values = params['values']\n    distinct_sorted = sorted(set(values), reverse=True)\n    k = count if count < len(distinct_sorted) else len(distinct_sorted)\n    return int(sum(distinct_sorted[:k]))",
  "brute_force_source": "def solve(params):\n    import itertools\n    count = params['count']\n    values = params['values']\n    distinct = list(set(values))\n    if count >= len(distinct):\n        return sum(distinct)\n    best = None\n    for combo in itertools.combinations(distinct, count):\n        s = sum(combo)\n        if best is None or s > best:\n            best = s\n    return int(best)",
