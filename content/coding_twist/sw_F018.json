  "solver_source": "def solve(params):\n    starts = params['starts']\n    ends = params['ends']\n    if not starts:\n        return 0\n    events = []\n    for s, e in zip(starts, ends):\n        if s < e:\n            events.append((s, 1))\n            events.append((e, -1))\n    events.sort()\n    total = 0\n    cur = 0\n    prev = None\n    i = 0\n    while i < len(events):\n        x = events[i][0]\n        if prev is not None and cur >= 2:\n            total += x - prev\n        j = i\n        while j < len(events) and events[j][0] == x:\n            cur += events[j][1]\n            j += 1\n        prev = x\n        i = j\n    return int(total)",
  "brute_force_source": "def solve(params):\n    starts = params['starts']\n    ends = params['ends']\n    if not starts:\n        return 0\n    lo = min(starts)\n    hi = max(ends)\n    total = 0\n    for t in range(lo, hi):\n        cnt = 0\n        for s, e in zip(starts, ends):\n            if s <= t < e:\n                cnt += 1\n                if cnt >= 2:\n                    break\n        if cnt >= 2:\n            total += 1\n    return int(total)",
