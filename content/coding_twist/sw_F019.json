  "solver_source": "def solve(params):\n    starts=params['starts']\n    ends=params['ends']\n    events=[]\n    for s,e in zip(starts, ends):\n        if s<e:\n            events.append((s, 1))\n            events.append((e, -1))\n    events.sort()\n    total=0\n    cur=0\n    prev=None\n    i=0\n    while i < len(events):\n        t=events[i][0]\n        if prev is not None and cur==2:\n            total+= t - prev\n        # process all events at t: end before start for [inclusive, exclusive)\n        # since we aggregated deltas, sum them together\n        delta=0\n        while i < len(events) and events[i][0]==t:\n            delta+=events[i][1]\n            i+=1\n        cur+=delta\n        prev=t\n    return int(total)\n",
  "brute_force_source": "def solve(params):\n    from fractions import Fraction\n    starts=params['starts']\n    ends=params['ends']\n    pts=set()\n    for s,e in zip(starts, ends):\n        pts.add(Fraction(s))\n        pts.add(Fraction(e))\n    pts=sorted(pts)\n    total=Fraction(0)\n    for i in range(len(pts)-1):\n        a=pts[i]\n        b=pts[i+1]\n        if b<=a:\n            continue\n        mid=(a+b)/2\n        cnt=0\n        for s,e in zip(starts, ends):\n            if Fraction(s) <= mid < Fraction(e):\n                cnt+=1\n        if cnt==2:\n            total+=(b-a)\n    return int(total)\n",
