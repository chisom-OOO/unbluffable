  "solver_source": "def solve(params):\n    values=params['values']\n    n=len(values)\n    if n<2:\n        return 0\n    l=0\n    r=n-1\n    best=0\n    while l<r:\n        hl=values[l]\n        hr=values[r]\n        h=hl if hl<hr else hr\n        vol=h*(r-l)\n        if vol>best:\n            best=vol\n        if hl<hr:\n            l+=1\n        elif hr<hl:\n            r-=1\n        else:\n            l+=1\n            r-=1\n    return int(best)\n",
