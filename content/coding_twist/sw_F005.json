  "solver_source": "def solve(params):\n    values = params[\"values\"]\n    k = params[\"length\"]\n    n = len(values)\n    if k >= n:\n        # if k equals n all circular windows are the whole array\n        # if k > n (should not happen per constraints) handle by full cycles\n        total = sum(values)\n        if k == n:\n            return int(total)\n        # general case: k = q*n + r\n        q, r = divmod(k, n)\n        base = q * total\n        if r == 0:\n            return int(base)\n        # best remainder window on circle\n        extended = values + values[:r-1] if r > 1 else values[:1]\n        cur = sum(extended[:r])\n        best_r = cur\n        for i in range(1, n):\n            cur = cur - extended[i-1] + extended[(i+r-1) % len(extended)] if (i+r-1) < len(extended) else cur - extended[i-1] + values[(i+r-1) % n]\n            # fallback to direct for safety when extended short\n            if (i+r-1) >= len(extended):\n                s = sum(values[(i+o) % n] for o in range(r))\n                if s > best_r:\n                    best_r = s\n            elif cur > best_r:\n                best_r = cur\n        return int(base + best_r)\n    # k < n: standard circular sliding window via duplication\n    extended = values + values\n    cur = sum(extended[:k])\n    best = cur\n    for i in range(1, n):\n        cur = cur - extended[i-1] + extended[i+k-1]\n        if cur > best:\n            best = cur\n    return int(best)\n",
  "brute_force_source": "def solve(params):\n    values = params[\"values\"]\n    k = params[\"length\"]\n    n = len(values)\n    best = None\n    for start in range(n):\n        s = 0\n        for offset in range(k):\n            s += values[(start + offset) % n]\n        if best is None or s > best:\n            best = s\n    return int(best)\n",
