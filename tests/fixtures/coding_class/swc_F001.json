  "solver_source": "def solve(params):\n    k = params[\"capacity\"]\n    items = []\n    steps = {}\n    total = 0\n    for i, op in enumerate(params[\"operations\"]):\n        if op[0] == \"push\":\n            items = (items + [op[1]])[-k:]\n        elif op[0] == \"max\":\n            steps[\"out_%d\" % i] = max(items)\n            total += max(items)\n        elif op[0] == \"full\":\n            steps[\"out_%d\" % i] = 1 if len(items) == k else 0\n        else:\n            steps[\"out_%d\" % i] = len(items)\n            total += len(items)\n    return {\"answer\": total, \"steps\": steps}\n",
